# Keep repository focused on unified microservices
/*
!/asn-service/
!/stimulsoft-service/
!/.gitignore
!/.dockerignore
!/.gitattributes
!/.github/

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Frontend
**/node_modules/
**/dist/
**/.vite/
**/coverage/

# .NET
stimulsoft-service/bin/
stimulsoft-service/obj/

# Local env/secrets/logs
**/.env
**/.env.*
**/license.key
**/*.log

# OS/editor
**/.DS_Store
**/Thumbs.db
